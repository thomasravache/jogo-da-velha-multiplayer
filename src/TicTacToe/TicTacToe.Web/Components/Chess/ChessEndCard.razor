<section data-end-card data-result="@ResultKind" aria-labelledby="chess-end-title" class="@("flex flex-col gap-2 rounded-card border p-4 " + Tone)">
    <h2 id="chess-end-title" data-end-title class="text-title-sm">@Title</h2>
    <p data-end-summary class="text-body-md text-ink-muted">@Summary</p>
</section>

@code {
    [Parameter] public ChessResult Result { get; set; } = default!;
    [Parameter] public string? WinnerName { get; set; }

    /// <summary>Meios-lances jogados.</summary>
    [Parameter] public int MoveCount { get; set; }
    [Parameter] public TimeSpan Duration { get; set; }

    /// <summary>Perspectiva de quem vê: true venceu, false perdeu, null neutro (empate ou sem perspectiva).</summary>
    [Parameter] public bool? ViewerWon { get; set; }

    private string ResultKind => ViewerWon switch { true => "win", false => "loss", _ => "neutral" };

    private string Tone => ViewerWon switch
    {
        true => "border-success/60 bg-success/10",
        false => "border-primary/60 bg-primary/10",
        _ => "border-stroke bg-surface/80",
    };

    private string Title => TitleFor(Result, WinnerName);

    public static string TitleFor(ChessResult result, string? winnerName) => result.Reason switch
    {
        ChessEndReason.Checkmate => $"Xeque-mate — {winnerName} venceu",
        ChessEndReason.Stalemate => "Empate por afogamento",
        ChessEndReason.InsufficientMaterial => "Empate por material insuficiente",
        ChessEndReason.FiftyMoveRule => "Empate pela regra dos 50 lances",
        ChessEndReason.ThreefoldRepetition => "Empate por repetição",
        ChessEndReason.Timeout when result.Outcome == ChessOutcome.Draw => "Empate por tempo (sem material de mate)",
        ChessEndReason.Timeout => $"Vitória por tempo — {winnerName} venceu",
        ChessEndReason.Resignation => $"Vitória por desistência — {winnerName} venceu",
        ChessEndReason.Abandon => $"Vitória por abandono — {winnerName} venceu",
        ChessEndReason.Disconnect => $"Vitória por desconexão — {winnerName} venceu",
        _ => "Partida encerrada",
    };

    private string Summary
    {
        get
        {
            var moves = (MoveCount + 1) / 2;
            return $"{moves} {(moves == 1 ? "lance" : "lances")} · duração {ChessPlayerCard.Format(Duration)}";
        }
    }
}
