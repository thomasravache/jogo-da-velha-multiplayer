@using TicTacToe.Modules.Gameplay

@if (CreatedRoomCode != null)
{
    <MudCard Class="lobby lobby-card waiting pa-6 text-center" Elevation="4">
        <MudCardContent Class="d-flex flex-column align-center gap-3">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="font-weight-bold">Sala criada!</MudText>
            <div class="room-code-badge">@CreatedRoomCode</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Compartilhe o código com seu amigo para começar 🔒</MudText>
        </MudCardContent>
    </MudCard>
}
else if (IsWaiting)
{
    <MudCard Class="lobby lobby-card waiting pa-6 text-center" Elevation="4">
        <MudCardContent Class="d-flex flex-column align-center gap-3">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6">Procurando oponente para <strong>@PlayerName</strong>... ⏳</MudText>
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Class="lobby lobby-card pa-6" Elevation="4">
        <MudCardContent Class="d-flex flex-column align-center gap-4">
            <div class="nickname-box d-flex flex-column align-center w-100">
                <label for="playerName" class="difficulty-label mb-1">Seu apelido</label>
                <input id="playerName"
                       type="text"
                       maxlength="20"
                       placeholder="Ex: Thomas"
                       value="@PlayerName"
                       @oninput="HandleNameInput"
                       class="name-input" />
            </div>

            <div class="mode-actions d-flex flex-column gap-3 w-100">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Public"
                           Disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                           OnClick="OnPlayOnline"
                           Class="btn-play">
                    Jogar Online 🌐
                </MudButton>

                <div class="solo-section d-flex flex-column gap-2">
                    <div class="difficulty-container d-flex align-center justify-space-between pa-2 rounded">
                        <span class="difficulty-label">Dificuldade:</span>
                        <div class="difficulty-selector" role="group" aria-label="Dificuldade da IA">
                            <MudButton Variant="@(SelectedDifficulty == AiDifficulty.Easy ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Class="@(SelectedDifficulty == AiDifficulty.Easy ? "btn-diff active" : "btn-diff")"
                                       aria-pressed="@(SelectedDifficulty == AiDifficulty.Easy)"
                                       OnClick="() => SetDifficulty(AiDifficulty.Easy)">
                                Fácil 🟢
                            </MudButton>
                            <MudButton Variant="@(SelectedDifficulty == AiDifficulty.Hard ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       Class="@(SelectedDifficulty == AiDifficulty.Hard ? "btn-diff active" : "btn-diff")"
                                       aria-pressed="@(SelectedDifficulty == AiDifficulty.Hard)"
                                       OnClick="() => SetDifficulty(AiDifficulty.Hard)">
                                Impossível 🔴
                            </MudButton>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Tertiary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.SmartToy"
                               Disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                               OnClick="OnPlaySolo"
                               Class="btn-play btn-solo">
                        Jogar vs Robô (IA) 🤖
                    </MudButton>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Dark"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                           OnClick="OnCreateRoom"
                           Class="btn-play btn-private">
                    Criar Sala Privada 🔒
                </MudButton>

                <div class="join-room-box d-flex gap-2">
                    <input type="text"
                           placeholder="Código (ex: SALA-ABCD)"
                           value="@InputRoomCode"
                           @oninput="HandleRoomCodeInput"
                           class="code-input" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               Disabled="@(string.IsNullOrWhiteSpace(PlayerName) || string.IsNullOrWhiteSpace(InputRoomCode))"
                               OnClick="OnJoinRoom"
                               Class="btn-join">
                        Entrar 🔑
                    </MudButton>
                </div>

                @if (!string.IsNullOrEmpty(RoomErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">@RoomErrorMessage</MudAlert>
                }
            </div>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public string PlayerName { get; set; } = "";
    [Parameter] public EventCallback<string> PlayerNameChanged { get; set; }

    [Parameter] public AiDifficulty SelectedDifficulty { get; set; } = AiDifficulty.Hard;
    [Parameter] public EventCallback<AiDifficulty> DifficultyChanged { get; set; }

    [Parameter] public string InputRoomCode { get; set; } = "";
    [Parameter] public EventCallback<string> InputRoomCodeChanged { get; set; }

    [Parameter] public bool IsWaiting { get; set; }
    [Parameter] public string? CreatedRoomCode { get; set; }
    [Parameter] public string? RoomErrorMessage { get; set; }

    [Parameter] public EventCallback OnPlayOnline { get; set; }
    [Parameter] public EventCallback OnPlaySolo { get; set; }
    [Parameter] public EventCallback OnCreateRoom { get; set; }
    [Parameter] public EventCallback OnJoinRoom { get; set; }

    private async Task HandleNameInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        PlayerName = val;
        await PlayerNameChanged.InvokeAsync(val);
    }

    private async Task SetDifficulty(AiDifficulty difficulty)
    {
        SelectedDifficulty = difficulty;
        await DifficultyChanged.InvokeAsync(difficulty);
    }

    private async Task HandleRoomCodeInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        InputRoomCode = val;
        await InputRoomCodeChanged.InvokeAsync(val);
    }
}
