@using TicTacToe.Modules.Gameplay
@using TicTacToe.Web.Components.Ui
@inject IJSRuntime JS

@if (CreatedRoomCode != null)
{
    <NeonCard Accent="CardAccent.O" Class="mx-auto flex w-full max-w-md flex-col items-center gap-4 p-6 text-center">
        <StatusChip Tone="ChipTone.Waiting" Dot="true">Aguardando amigo</StatusChip>
        <h2 class="text-headline-md">Sala criada!</h2>
        <p class="font-numeric text-headline-lg tracking-[0.15em] text-secondary" aria-label="Código da sala">@CreatedRoomCode</p>
        <PillButton Variant="PillVariant.Outline" Icon="@(_copy == CopyState.Copied ? "check" : "copy")" OnClick="CopyCode">Copiar</PillButton>
        <p class="text-body-md text-ink-muted" role="status" aria-live="polite">
            @(_copy switch
            {
                CopyState.Copied => "Código copiado!",
                CopyState.Failed => "Não foi possível copiar. Selecione o código acima e copie manualmente.",
                _ => "Compartilhe o código com seu amigo para começar 🔒",
            })
        </p>
    </NeonCard>
}
else if (IsWaiting)
{
    <NeonCard Class="mx-auto flex w-full max-w-md flex-col items-center gap-4 p-6 text-center">
        <span class="size-10 animate-spin motion-reduce:animate-none rounded-full border-4 border-secondary border-t-transparent" aria-hidden="true"></span>
        <StatusChip Tone="ChipTone.Waiting" Dot="true">Na fila</StatusChip>
        <p class="text-title-sm" role="status" aria-live="polite">Procurando oponente para @PlayerName…</p>
    </NeonCard>
}
else
{
    <div class="mx-auto flex w-full max-w-[var(--size-frame)] flex-col gap-6 py-4">
        <PageHeader Eyebrow="XO Arena" Title="Arena de Batalhas XO" Subtitle="@WelcomeText" />

        <NeonCard Class="flex flex-col gap-3 p-5 md:flex-row md:items-end">
            <div class="flex-1">
                <NeonInput Id="playerName" Label="Seu apelido" Placeholder="Ex: Thomas" MaxLength="20" ShowCounter="true"
                           Value="@PlayerName" ValueChanged="HandleNameInput" />
                <p class="mt-2 text-body-md text-ink-muted">Seu identificador de jogador fica salvo neste navegador.</p>
            </div>
            <StatusChip Tone="@(HasName ? ChipTone.Online : ChipTone.Neutral)" Dot="@HasName">
                @(HasName ? "Pronto para jogar" : "Informe seu apelido")
            </StatusChip>
        </NeonCard>

        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            <NeonCard Accent="CardAccent.X" Class="flex flex-col gap-4 p-5">
                <StatusChip Tone="ChipTone.Danger">Multiplayer online</StatusChip>
                <h2 class="text-headline-md">Duelo Online 1v1</h2>
                <p class="text-body-md text-ink-muted">Encontre um oponente humano na fila e jogue agora.</p>
                <div class="flex items-center justify-between rounded-cell bg-surface-high/60 px-4 py-3">
                    <span class="text-body-md text-ink-muted">Tempo por turno</span>
                    <span class="font-numeric text-label-numeric">@GameSession.DefaultTurnTimeSeconds segundos</span>
                </div>
                <PillButton Size="PillSize.Lg" Icon="globe" Class="mt-auto" Disabled="@(!HasName)" OnClick="OnPlayOnline">Procurar oponente</PillButton>
            </NeonCard>

            <NeonCard Accent="CardAccent.O" Class="flex flex-col gap-4 p-5">
                <StatusChip Tone="ChipTone.Waiting">Treino solo</StatusChip>
                <h2 class="text-headline-md">Duelo contra IA</h2>
                <SegmentedControl TValue="AiDifficulty" AriaLabel="Dificuldade da IA"
                                  Items="_difficultyItems" Value="SelectedDifficulty" ValueChanged="SetDifficulty" />
                <p class="text-body-md text-ink-muted">
                    @(SelectedDifficulty == AiDifficulty.Easy
                        ? "O robô joga em casas aleatórias. Bom para aquecer."
                        : "Algoritmo Minimax: o robô calcula todas as jogadas possíveis e nunca perde.")
                </p>
                <PillButton Variant="PillVariant.Outline" Size="PillSize.Lg" Icon="robot" Class="mt-auto" Disabled="@(!HasName)" OnClick="OnPlaySolo">Iniciar partida solo</PillButton>
            </NeonCard>

            <NeonCard Class="flex flex-col gap-4 p-5">
                <StatusChip Tone="ChipTone.Neutral">Entre amigos</StatusChip>
                <h2 class="text-headline-md">Sala Privada</h2>
                <SegmentedControl TValue="RoomTab" AriaLabel="Ação da sala privada"
                                  Items="_roomItems" Value="_tab" ValueChanged="SetTab" />
                @if (_tab == RoomTab.Create)
                {
                    <p class="text-body-md text-ink-muted">Crie uma sala e compartilhe o código com um amigo.</p>
                    <PillButton Variant="PillVariant.Outline" Size="PillSize.Lg" Icon="lock" Class="mt-auto" Disabled="@(!HasName)" OnClick="OnCreateRoom">Criar sala 🔒</PillButton>
                }
                else
                {
                    <NeonInput Id="roomCode" Label="Código da sala" Placeholder="Ex: SALA-ABCD" MaxLength="20"
                               Value="@InputRoomCode" ValueChanged="HandleRoomCodeInput" />
                    <PillButton Variant="PillVariant.Outline" Size="PillSize.Lg" Icon="key" Class="mt-auto"
                                Disabled="@(!HasName || string.IsNullOrWhiteSpace(InputRoomCode))" OnClick="OnJoinRoom">Entrar 🔑</PillButton>
                }
                @if (!string.IsNullOrEmpty(RoomErrorMessage))
                {
                    <p role="alert" class="rounded-cell bg-primary/15 px-4 py-2 text-body-md text-primary">@RoomErrorMessage</p>
                }
            </NeonCard>
        </div>
    </div>
}

@code {
    private enum RoomTab { Create, Join }

    private enum CopyState { None, Copied, Failed }

    private static readonly IReadOnlyList<(AiDifficulty Value, string Label)> _difficultyItems =
    [
        (AiDifficulty.Easy, "Fácil 🟢"),
        (AiDifficulty.Hard, "Impossível 🔴"),
    ];

    private static readonly IReadOnlyList<(RoomTab Value, string Label)> _roomItems =
    [
        (RoomTab.Create, "Criar sala"),
        (RoomTab.Join, "Entrar com código"),
    ];

    private RoomTab _tab = RoomTab.Create;
    private CopyState _copy = CopyState.None;

    [Parameter] public string? ReturningPlayerName { get; set; }

    [Parameter] public string PlayerName { get; set; } = "";
    [Parameter] public EventCallback<string> PlayerNameChanged { get; set; }

    [Parameter] public AiDifficulty SelectedDifficulty { get; set; } = AiDifficulty.Hard;
    [Parameter] public EventCallback<AiDifficulty> DifficultyChanged { get; set; }

    [Parameter] public SeriesFormat SelectedFormat { get; set; } = SeriesFormat.Single;
    [Parameter] public EventCallback<SeriesFormat> FormatChanged { get; set; }

    [Parameter] public string InputRoomCode { get; set; } = "";
    [Parameter] public EventCallback<string> InputRoomCodeChanged { get; set; }

    [Parameter] public bool IsWaiting { get; set; }
    [Parameter] public string? CreatedRoomCode { get; set; }
    [Parameter] public string? RoomErrorMessage { get; set; }

    [Parameter] public EventCallback OnPlayOnline { get; set; }
    [Parameter] public EventCallback OnPlaySolo { get; set; }
    [Parameter] public EventCallback OnCreateRoom { get; set; }
    [Parameter] public EventCallback OnJoinRoom { get; set; }

    private string? _copiedFor;

    protected override void OnParametersSet()
    {
        if (_copiedFor != CreatedRoomCode)
        {
            _copy = CopyState.None;
            _copiedFor = CreatedRoomCode;
        }
    }

    private string WelcomeText => string.IsNullOrWhiteSpace(ReturningPlayerName)
        ? "Escolha seu modo de combate e desafie um oponente."
        : $"Bem-vindo de volta, {ReturningPlayerName}. Escolha seu modo de combate.";

    private bool HasName => !string.IsNullOrWhiteSpace(PlayerName);

    private async Task HandleNameInput(string value)
    {
        PlayerName = value;
        await PlayerNameChanged.InvokeAsync(value);
    }

    private async Task HandleRoomCodeInput(string value)
    {
        InputRoomCode = value;
        await InputRoomCodeChanged.InvokeAsync(value);
    }

    private async Task SetDifficulty(AiDifficulty difficulty)
    {
        SelectedDifficulty = difficulty;
        await DifficultyChanged.InvokeAsync(difficulty);
    }

    private void SetTab(RoomTab tab) => _tab = tab;

    private async Task CopyCode()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CreatedRoomCode);
            _copy = CopyState.Copied;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            _copy = CopyState.Failed;
        }
    }
}
