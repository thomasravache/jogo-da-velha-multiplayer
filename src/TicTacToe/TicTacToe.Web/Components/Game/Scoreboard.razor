@using TicTacToe.Web.Components.Ui
@using TicTacToe.Modules.Gameplay

@if (Game != null)
{
    var running = Game.Winner == Player.None && !Game.IsDraw;

    <div class="contents">
        <PlayerCard Player="Player.X" Name="@Game.GetPlayerName(Player.X)" Score="@Game.GetScore(Player.X)"
                    IsMe="@(MyPlayer == Player.X)" IsActive="@(running && Game.CurrentTurn == Player.X)"
                    Class="lg:col-start-1 lg:row-start-2" />
        <PlayerCard Player="Player.O" Name="@Game.GetPlayerName(Player.O)" Score="@Game.GetScore(Player.O)"
                    IsMe="@(MyPlayer == Player.O)" IsActive="@(running && Game.CurrentTurn == Player.O)"
                    Class="lg:col-start-3 lg:row-start-2" />

        <p aria-live="polite" class="col-span-2 text-center text-title-sm lg:col-span-1 lg:col-start-2 lg:row-start-1">@StatusText()</p>
    </div>
}

@code {
    [Parameter] public GameSession Game { get; set; } = default!;
    [Parameter] public Player MyPlayer { get; set; }

    private string StatusText()
    {
        var myName = Game.GetPlayerName(MyPlayer);

        if (Game.Winner != Player.None)
        {
            return Game.Winner == MyPlayer
                ? $"Você venceu, {myName}! 🎉"
                : $"{Game.GetPlayerName(Game.Winner)} venceu! 😅";
        }

        if (Game.IsDraw)
        {
            return "Deu velha! 🤝";
        }

        return Game.CurrentTurn == MyPlayer
            ? $"Sua vez, {myName}!"
            : $"Vez de {Game.GetPlayerName(Game.CurrentTurn)}…";
    }
}
