@page "/xadrez"
@using TicTacToe.Modules.Gameplay
@using TicTacToe.Web.Components.Chess
@using TicTacToe.Web.Components.Game
@using TicTacToe.Web.Components.Ui
@rendermode InteractiveServer

<PageTitle>Xadrez · XO Arena</PageTitle>

@if (Session is null)
{
    <ChessLobby ReturningPlayerName="@_returningName"
                PlayerName="@_playerName"
                PlayerNameChanged="v => _playerName = v"
                SelectedControl="@_control"
                ControlChanged="c => _control = c"
                SelectedColor="@_color"
                ColorChanged="c => _color = c"
                InputRoomCode="@_inputRoomCode"
                InputRoomCodeChanged="c => _inputRoomCode = c"
                IsWaiting="@_isWaiting"
                CreatedRoomCode="@_createdRoomCode"
                RoomErrorMessage="@_roomError"
                SelectedLevel="@_level"
                LevelChanged="l => _level = l"
                OnPlaySolo="StartSolo"
                OnPlayOnline="FindMatch"
                OnCancelSearch="CancelSearch"
                OnCreateRoom="CreateRoom"
                OnJoinRoom="JoinRoom" />
}
else
{
    <div class="mx-auto flex w-full max-w-[var(--size-frame-chess)] flex-col gap-4">
        <ChessArena Session="Session" MySeat="_seat" OnLeave="LeaveGame" />
        <RematchBar Finished="Session.IsOver" Kind="RematchBar.RematchKind.Rematch" Consent="!_solo"
                    State="@RematchStateOf(Session)" RequestedByMe="@(Session.RematchRequestedBy == MyColor)"
                    RequesterName="@(Session.RematchRequestedBy is { } requester ? Session.GetPlayerName(requester) : null)"
                    OpponentLeft="@Session.HasLeft(MyColor == PieceColor.White ? PieceColor.Black : PieceColor.White)"
                    OnRematch="RematchSolo" OnRequest="RequestRematch" OnAccept="AcceptRematch" OnDecline="DeclineRematch"
                    OnBackToLobby="BackToLobby" />
        @if (_solo && !Session.IsOver)
        {
            <div class="flex justify-center">
                <PillButton Variant="PillVariant.Outline" Icon="close" OnClick="AbandonSolo">Abandonar</PillButton>
            </div>
        }
    </div>
}
