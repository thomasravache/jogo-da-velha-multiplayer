@page "/history"
@using TicTacToe.Modules.Gameplay
@using TicTacToe.Web.Components.Ui
@rendermode InteractiveServer
@inject GameResultService GameResultService

<PageTitle>Histórico de Partidas · XO Arena</PageTitle>

<div class="mx-auto flex w-full max-w-[var(--size-frame)] flex-col gap-6 py-4">
    <PageHeader Eyebrow="Partidas" Title="Histórico de Partidas"
                Subtitle="@SubtitleText">
        <PillButton Href="/" Icon="play">Novo duelo</PillButton>
    </PageHeader>

    @if (_loading)
    {
        <NeonCard Class="flex items-center justify-center gap-3 p-8">
            <span class="size-6 animate-spin motion-reduce:animate-none rounded-full border-2 border-secondary border-t-transparent" aria-hidden="true"></span>
            <p role="status" class="text-body-lg text-ink-muted">Carregando…</p>
        </NeonCard>
    }
    else if (_results.Count == 0)
    {
        <NeonCard Class="flex flex-col items-center gap-4 p-8 text-center">
            <Icon Name="trophy" Size="24" />
            <p class="text-title-sm">Nenhuma partida registrada ainda.</p>
            <PillButton Href="/" Icon="play">Jogar agora</PillButton>
        </NeonCard>
    }
    else
    {
        <NeonCard Class="overflow-hidden">
            <table class="w-full border-collapse text-left">
                <thead class="hidden md:table-header-group">
                    <tr class="border-b border-stroke font-numeric text-label-badge uppercase text-ink-muted">
                        <th scope="col" class="px-5 py-3">Resultado</th>
                        <th scope="col" class="px-5 py-3">Duelo (✕ vs ◯)</th>
                        <th scope="col" class="px-5 py-3">Data e hora</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _results)
                    {
                        var xWins = r.WinnerName is not null && r.WinnerName == r.PlayerXName && r.PlayerXName != r.PlayerOName;
                        var oWins = r.WinnerName is not null && r.WinnerName == r.PlayerOName && r.PlayerXName != r.PlayerOName;
                        <tr class="block border-b border-stroke px-5 py-4 last:border-b-0 md:table-row md:px-0 md:py-0">
                            <td class="block md:table-cell md:px-5 md:py-4">
                                @if (r.WinnerName is not null)
                                {
                                    <StatusChip Tone="ChipTone.Gold">Vitória de @r.WinnerName</StatusChip>
                                }
                                else
                                {
                                    <StatusChip Tone="ChipTone.Neutral">Deu velha</StatusChip>
                                }
                            </td>
                            <td class="block py-2 md:table-cell md:px-5 md:py-4">
                                <span class="flex flex-wrap items-center gap-2 text-body-lg">
                                    <span class="min-w-0 break-words text-primary" data-winner="@(xWins ? "true" : null)">
                                        ✕ @r.PlayerXName@if (xWins) {<Icon Name="trophy" Size="16" Label="Vencedor" />}
                                    </span>
                                    <span class="text-ink-muted">vs</span>
                                    <span class="min-w-0 break-words text-secondary" data-winner="@(oWins ? "true" : null)">
                                        ◯ @r.PlayerOName@if (oWins) {<Icon Name="trophy" Size="16" Label="Vencedor" />}
                                    </span>
                                </span>
                            </td>
                            <td class="block font-numeric text-label-numeric text-ink-muted md:table-cell md:px-5 md:py-4">
                                @HistoryDateFormatter.Format(r.PlayedAt, _now)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </NeonCard>
    }
</div>

@code {
    private List<MatchResult> _results = [];
    private bool _loading = true;
    private DateTime _now = DateTime.Now;

    private string? SubtitleText => _loading || _results.Count == 0
        ? null
        : _results.Count == 1 ? "Última partida" : $"Últimas {_results.Count} partidas";

    protected override async Task OnInitializedAsync()
    {
        _results = await GameResultService.GetRecentAsync(10);
        _now = DateTime.Now;
        _loading = false;
    }
}
