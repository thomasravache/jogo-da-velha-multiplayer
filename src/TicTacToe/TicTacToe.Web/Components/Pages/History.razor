@page "/history"
@using TicTacToe.Modules.Gameplay
@rendermode InteractiveServer
@inject GameResultService GameResultService

<PageTitle>Histórico de Partidas</PageTitle>

<div class="history-container">
    <div class="header">
        <a href="/" class="back-link">← Jogar</a>
        <h1>Histórico de Partidas</h1>
    </div>

    @if (_loading)
    {
        <div class="loading">Carregando... ⏳</div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty">
            <p>🎮 Nenhuma partida registrada ainda.</p>
            <p><a href="/">Jogue agora</a> e volte aqui!</p>
        </div>
    }
    else
    {
        <table class="results-table">
            <thead>
                <tr>
                    <th scope="col">✕ Jogador X</th>
                    <th scope="col">◯ Jogador O</th>
                    <th scope="col">Resultado</th>
                    <th scope="col">Data</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _results)
                {
                    <tr>
                        <td class="player-x">@r.PlayerXName</td>
                        <td class="player-o">@r.PlayerOName</td>
                        <td class="result @(r.WinnerName == null ? "draw" : "win")">
                            @(r.WinnerName != null ? $"🏆 {r.WinnerName}" : "🤝 Empate")
                        </td>
                        <td class="date">@r.PlayedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    :root { --x-color: #e74c3c; --o-color: #3498db; --bg: #1a1a2e; --surface: #16213e; --text: #e0e0e0; }
    body { background: var(--bg); color: var(--text); margin: 0; }
    .history-container { font-family: 'Segoe UI', sans-serif; max-width: 700px; margin: 0 auto; padding: 40px 20px; }
    .header { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
    .back-link { color: #888; text-decoration: none; font-size: 1rem; }
    .back-link:hover { color: var(--text); }
    h1 { font-size: 1.6rem; margin: 0; }
    .loading, .empty { text-align: center; padding: 60px; color: #888; font-size: 1.1rem; }
    .empty a { color: var(--x-color); text-decoration: none; }
    .results-table { width: 100%; border-collapse: collapse; }
    .results-table th { background: var(--surface); padding: 12px 16px; text-align: left; font-size: .85rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .results-table td { padding: 14px 16px; border-bottom: 1px solid #1f2a45; font-size: .95rem; }
    .results-table tr:last-child td { border-bottom: none; }
    .results-table tr:hover td { background: rgba(255,255,255,0.03); }
    .player-x { color: var(--x-color); font-weight: 500; }
    .player-o { color: var(--o-color); font-weight: 500; }
    .result.win { color: #f1c40f; }
    .result.draw { color: #888; }
    .date { color: #555; font-size: .85rem; }
</style>

@code {
    private List<MatchResult> _results = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _results = await GameResultService.GetRecentAsync(10);
        _loading = false;
    }
}
