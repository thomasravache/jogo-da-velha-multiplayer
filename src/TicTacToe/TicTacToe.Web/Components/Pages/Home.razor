@page "/"
@using TicTacToe.Modules.Matchmaking
@using TicTacToe.Modules.Gameplay
@using System.Collections.Concurrent
@rendermode InteractiveServer
@inject MatchmakingService Matchmaking
@inject ConcurrentDictionary<Guid, GameSession> Games
@inject GameResultService GameResultService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Jogo da Velha Multiplayer</PageTitle>

<div class="game-container">
    <h1>Jogo da Velha ✕ ◯</h1>

    @if (MatchId == null)
    {
        if (CreatedRoomCode != null)
        {
            <div class="lobby waiting">
                <div class="spinner"></div>
                <p>Sala criada!</p>
                <div class="room-code-badge">@CreatedRoomCode</div>
                <p>Compartilhe o código com seu amigo para começar 🔒</p>
            </div>
        }
        else if (IsWaiting)
        {
            <div class="lobby waiting">
                <div class="spinner"></div>
                <p>Procurando oponente para <strong>@PlayerName</strong>... ⏳</p>
            </div>
        }
        else
        {
            <div class="lobby">
                <label for="playerName">Seu apelido</label>
                <input id="playerName"
                       type="text"
                       maxlength="20"
                       placeholder="Ex: Thomas"
                       @bind="PlayerName"
                       @bind:event="oninput"
                       class="name-input" />
                <div class="mode-actions">
                    <button class="btn-play"
                            disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                            @onclick="FindMatch">
                        Jogar Online 🌐
                    </button>
                    <button class="btn-play btn-solo"
                            disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                            @onclick="StartSoloGame">
                        Jogar vs Robô (IA) 🤖
                    </button>
                    <button class="btn-play btn-private"
                            disabled="@(string.IsNullOrWhiteSpace(PlayerName))"
                            @onclick="CreateRoom">
                        Criar Sala Privada 🔒
                    </button>
                    <div class="join-room-box">
                        <input type="text"
                               placeholder="Código (ex: SALA-ABCD)"
                               @bind="InputRoomCode"
                               class="code-input" />
                        <button class="btn-join"
                                disabled="@(string.IsNullOrWhiteSpace(PlayerName) || string.IsNullOrWhiteSpace(InputRoomCode))"
                                @onclick="JoinRoom">
                            Entrar 🔑
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(RoomErrorMessage))
                    {
                        <span class="error-msg">@RoomErrorMessage</span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        var game = Games[MatchId.Value];
        var currentName = game.GetPlayerName(game.CurrentTurn);
        var myName = game.GetPlayerName(MyPlayer);

        <div class="players-bar">
            <span class="player-tag x @(MyPlayer == Player.X ? "me" : "")">
                ✕ @game.GetPlayerName(Player.X) <span class="score-badge">@game.GetScore(Player.X)</span>
            </span>
            <span class="vs">vs</span>
            <span class="player-tag o @(MyPlayer == Player.O ? "me" : "")">
                ◯ @game.GetPlayerName(Player.O) <span class="score-badge">@game.GetScore(Player.O)</span>
            </span>
        </div>

        <div class="status">
            @if (game.Winner != Player.None)
            {
                var winnerName = game.GetPlayerName(game.Winner);
                if (game.Winner == MyPlayer)
                {
                    <strong class="win">Você venceu, @myName! 🎉</strong>
                }
                else
                {
                    <strong class="lose">@winnerName venceu! 😅</strong>
                }
            }
            else if (game.IsDraw)
            {
                <strong>Deu velha! 🤝</strong>
            }
            else
            {
                @if (game.CurrentTurn == MyPlayer)
                {
                    <span class="my-turn">Sua vez, <strong>@myName</strong>!</span>
                }
                else
                {
                    <span>Vez de <strong>@currentName</strong>...</span>
                }
            }
        </div>

        <div class="board">
            @for (int i = 0; i < 9; i++)
            {
                var index = i;
                var cell = game.Board[index];
                var canPlay = game.Winner == Player.None && !game.IsDraw && game.CurrentTurn == MyPlayer && cell == Player.None;
                <div class="cell @(cell.ToString().ToLower()) @(canPlay ? "playable" : "")"
                     @onclick="() => MakeMove(index)">
                    @(cell == Player.None ? "" : (cell == Player.X ? "✕" : "◯"))
                </div>
            }
        </div>

        @if (game.Winner != Player.None || game.IsDraw)
        {
            <div class="actions">
                <button class="btn-rematch" @onclick="RestartGame">
                    Jogar Novamente 🔄
                </button>
            </div>
        }
    }
</div>

<style>
    :root { --x-color: #e74c3c; --o-color: #3498db; --bg: #1a1a2e; --surface: #16213e; --surface2: #0f3460; --text: #e0e0e0; }
    body { background: var(--bg); color: var(--text); margin: 0; }
    .game-container { font-family: 'Segoe UI', sans-serif; text-align: center; padding: 40px 20px; max-width: 480px; margin: 0 auto; }
    h1 { font-size: 2rem; color: #e0e0e0; margin-bottom: 30px; letter-spacing: 2px; }

    /* Lobby */
    .lobby { background: var(--surface); padding: 40px; border-radius: 16px; display: flex; flex-direction: column; gap: 16px; align-items: center; }
    label { font-size: 1rem; color: #aaa; }
    .name-input { padding: 12px 18px; font-size: 1.1rem; border: 2px solid var(--surface2); border-radius: 8px; background: var(--bg); color: var(--text); width: 220px; text-align: center; outline: none; transition: border-color .2s; }
    .name-input:focus { border-color: #e74c3c; }
    .btn-play { padding: 14px 32px; font-size: 1.1rem; cursor: pointer; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; border-radius: 8px; font-weight: bold; transition: opacity .2s, transform .1s; }
    .btn-play:hover:not(:disabled) { transform: translateY(-2px); opacity: .9; }
    .btn-play:disabled { opacity: .4; cursor: not-allowed; }
    .mode-actions { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 260px; }
    .btn-solo { background: linear-gradient(135deg, #8e44ad, #9b59b6); }
    .btn-private { background: linear-gradient(135deg, #2c3e50, #34495e); }
    .join-room-box { display: flex; gap: 6px; margin-top: 6px; }
    .code-input { flex: 1; padding: 10px; font-size: 0.95rem; border: 2px solid var(--surface2); border-radius: 8px; background: var(--bg); color: var(--text); text-align: center; text-transform: uppercase; outline: none; }
    .code-input:focus { border-color: #3498db; }
    .btn-join { padding: 10px 18px; font-size: 0.95rem; cursor: pointer; background: #3498db; color: white; border: none; border-radius: 8px; font-weight: bold; }
    .btn-join:disabled { opacity: 0.4; cursor: not-allowed; }
    .room-code-badge { font-size: 1.8rem; font-weight: bold; letter-spacing: 3px; color: #f1c40f; padding: 10px 20px; background: var(--surface2); border-radius: 8px; display: inline-block; margin: 10px 0; border: 2px dashed #f1c40f; }
    .error-msg { color: #e74c3c; font-size: 0.85rem; margin-top: 4px; }
    .waiting { gap: 12px; }
    .spinner { width: 40px; height: 40px; border: 4px solid var(--surface2); border-top-color: #e74c3c; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Players Bar */
    .players-bar { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 16px; }
    .player-tag { padding: 6px 16px; border-radius: 20px; font-weight: bold; background: var(--surface); font-size: .95rem; }
    .player-tag.x { color: var(--x-color); border: 2px solid var(--x-color); }
    .player-tag.o { color: var(--o-color); border: 2px solid var(--o-color); }
    .player-tag.me { box-shadow: 0 0 10px rgba(255,255,255,0.15); }
    .score-badge { display: inline-block; background: rgba(255,255,255,0.18); padding: 1px 7px; border-radius: 10px; margin-left: 6px; font-size: 0.85rem; font-weight: bold; }
    .vs { color: #666; font-size: .85rem; }

    /* Status */
    .status { margin: 16px 0 24px; font-size: 1.3rem; min-height: 40px; }
    .my-turn { color: #2ecc71; }
    .win { color: #2ecc71; font-size: 1.5rem; }
    .lose { color: #e74c3c; }

    /* Board */
    .board { display: grid; grid-template-columns: repeat(3, 110px); gap: 8px; justify-content: center; }
    .cell { width: 110px; height: 110px; background: var(--surface); font-size: 2.8rem; display: flex; align-items: center; justify-content: center; border-radius: 12px; transition: background .15s, transform .1s; cursor: default; user-select: none; }
    .cell.playable { cursor: pointer; }
    .cell.playable:hover { background: var(--surface2); transform: scale(1.04); }
    .cell.x { color: var(--x-color); }
    .cell.o { color: var(--o-color); }

    /* Actions */
    .actions { margin-top: 24px; }
    .btn-rematch { padding: 12px 28px; font-size: 1.1rem; cursor: pointer; background: linear-gradient(135deg, #2ecc71, #27ae60); color: white; border: none; border-radius: 8px; font-weight: bold; transition: opacity .2s, transform .1s; }
    .btn-rematch:hover { transform: translateY(-2px); opacity: .9; }
</style>

@code {
    private string ConnectionId = Guid.NewGuid().ToString();
    private string PlayerName = "";
    private Guid? MatchId;
    private bool IsWaiting = false;
    private Player MyPlayer;
    private System.Threading.Timer? _pollTimer;
    private bool _confettiFired = false;
    private string? CreatedRoomCode;
    private string InputRoomCode = "";
    private string? RoomErrorMessage;

    private void CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(PlayerName)) return;
        RoomErrorMessage = null;
        CreatedRoomCode = Matchmaking.CreatePrivateRoom(ConnectionId, PlayerName.Trim());
        _pollTimer = new System.Threading.Timer(CheckMatchStatus, null, 500, 500);
    }

    private void JoinRoom()
    {
        if (string.IsNullOrWhiteSpace(PlayerName) || string.IsNullOrWhiteSpace(InputRoomCode)) return;
        RoomErrorMessage = null;
        var matchId = Matchmaking.JoinPrivateRoom(InputRoomCode, ConnectionId, PlayerName.Trim());
        if (matchId != null)
        {
            MatchId = matchId;
            MyPlayer = Player.O;
            EnsureGameExists();
        }
        else
        {
            RoomErrorMessage = "Sala inválida ou já iniciada!";
        }
    }

    private void FindMatch()
    {
        if (string.IsNullOrWhiteSpace(PlayerName)) return;

        IsWaiting = true;
        MatchId = Matchmaking.JoinQueue(ConnectionId, PlayerName.Trim());

        if (MatchId != null)
        {
            MyPlayer = Player.O;
            IsWaiting = false;
            EnsureGameExists();
        }
        else
        {
            _pollTimer = new System.Threading.Timer(CheckMatchStatus, null, 500, 500);
        }
    }

    private void CheckMatchStatus(object? state)
    {
        if (Matchmaking.ActiveMatches.TryGetValue(ConnectionId, out var matchId))
        {
            MatchId = matchId;
            MyPlayer = Player.X;
            IsWaiting = false;
            EnsureGameExists();
            _pollTimer?.Dispose();
            InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnInitialized()
    {
        Matchmaking.OnPlayerMatched += OnMatchedReceived;
    }

    private void OnMatchedReceived(string connectionId, Guid matchId)
    {
        if (connectionId == ConnectionId && MatchId == null)
        {
            MatchId = matchId;
            MyPlayer = Player.X;
            IsWaiting = false;
            CreatedRoomCode = null;
            EnsureGameExists();
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void EnsureGameExists()
    {
        if (MatchId != null && !Games.ContainsKey(MatchId.Value))
        {
            var game = new GameSession();
            Games.TryAdd(MatchId.Value, game);
        }

        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var existingGame))
        {
            existingGame.OnStateChanged -= OnGameStateChanged;
            existingGame.OnStateChanged += OnGameStateChanged;

            var matchPlayers = Matchmaking.ActiveMatches
                .Where(kvp => kvp.Value == MatchId.Value)
                .Select(kvp => kvp.Key)
                .ToList();

            if (matchPlayers.Count == 2)
            {
                var xName = Matchmaking.GetPlayerName(matchPlayers[0]) ?? "X";
                var oName = Matchmaking.GetPlayerName(matchPlayers[1]) ?? "O";
                existingGame.SetPlayerName(Player.X, xName);
                existingGame.SetPlayerName(Player.O, oName);
            }
        }

        _pollTimer = new System.Threading.Timer(async _ => await OnPollTick(), null, 1000, 1000);
    }

    private async void OnGameStateChanged()
    {
        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var g))
        {
            if (g.Winner == MyPlayer && !_confettiFired)
            {
                _confettiFired = true;
                try
                {
                    await JS.InvokeVoidAsync("triggerConfetti");
                }
                catch { }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPollTick()
    {
        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var g))
        {
            if (g.Winner == MyPlayer && !_confettiFired)
            {
                _confettiFired = true;
                try
                {
                    await JS.InvokeVoidAsync("triggerConfetti");
                }
                catch { }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private bool IsSoloGame = false;
    private AiDifficulty SelectedDifficulty = AiDifficulty.Hard;

    private void StartSoloGame()
    {
        if (string.IsNullOrWhiteSpace(PlayerName)) return;

        IsSoloGame = true;
        MatchId = Guid.NewGuid();
        MyPlayer = Player.X;

        var game = new GameSession();
        game.SetPlayerName(Player.X, PlayerName.Trim());
        game.SetPlayerName(Player.O, "Robô Minimax 🤖");
        game.OnStateChanged += OnGameStateChanged;
        Games.TryAdd(MatchId.Value, game);

        _pollTimer = new System.Threading.Timer(async _ => await OnPollTick(), null, 1000, 1000);
    }

    private async Task MakeMove(int index)
    {
        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var game))
        {
            if (game.CurrentTurn == MyPlayer)
            {
                var moved = game.MakeMove(index, MyPlayer);
                if (moved)
                {
                    if (game.Winner != Player.None || game.IsDraw)
                    {
                        await GameResultService.SaveResultAsync(game);
                    }
                    else if (IsSoloGame && game.CurrentTurn == Player.O)
                    {
                        _ = Task.Run(async () =>
                        {
                            await Task.Delay(250);
                            int aiMove = AiPlayer.GetBestMove(game, Player.O, SelectedDifficulty);
                            if (aiMove != -1)
                            {
                                game.MakeMove(aiMove, Player.O);
                                if (game.Winner != Player.None || game.IsDraw)
                                {
                                    await GameResultService.SaveResultAsync(game);
                                }
                                await InvokeAsync(StateHasChanged);
                            }
                        });
                    }
                }
            }
        }
    }

    private void RestartGame()
    {
        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var game))
        {
            _confettiFired = false;
            game.Restart();
        }
    }

    public void Dispose()
    {
        Matchmaking.OnPlayerMatched -= OnMatchedReceived;
        if (MatchId != null && Games.TryGetValue(MatchId.Value, out var g))
        {
            g.OnStateChanged -= OnGameStateChanged;
        }
        _pollTimer?.Dispose();
    }
}
