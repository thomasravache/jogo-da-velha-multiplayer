@page "/"
@using TicTacToe.Modules.Matchmaking
@using TicTacToe.Modules.Gameplay
@using TicTacToe.Web.Components.Game
@using System.Collections.Concurrent
@rendermode InteractiveServer
@inject MatchmakingService Matchmaking
@inject ConcurrentDictionary<Guid, GameSession> Games
@inject GameResultService GameResultService
@inject IJSRuntime JS
@inject TicTacToe.Web.Services.PlayerIdentity.PlayerIdentityService Identity

<PageTitle>XO Arena</PageTitle>

@if (MatchId == null)
{
    <Lobby ReturningPlayerName="@ReturningName"
           PlayerName="@PlayerName"
           PlayerNameChanged="v => PlayerName = v"
           SelectedDifficulty="@SelectedDifficulty"
           DifficultyChanged="d => SelectedDifficulty = d"
           SelectedFormat="@SelectedFormat"
           FormatChanged="f => SelectedFormat = f"
           InputRoomCode="@InputRoomCode"
           InputRoomCodeChanged="c => InputRoomCode = c"
           IsWaiting="@IsWaiting"
           CreatedRoomCode="@CreatedRoomCode"
           RoomErrorMessage="@RoomErrorMessage"
           OnPlayOnline="FindMatch"
           OnPlaySolo="StartSoloGame"
           OnCreateRoom="CreateRoom"
           OnJoinRoom="JoinRoom" />
}
else
{
    var game = Games[MatchId.Value];

    <div class="game-container mx-auto grid w-full grid-cols-2 gap-4 lg:grid-cols-[1fr_minmax(0,var(--size-board-desktop))_1fr] lg:items-start lg:gap-6">
        <Scoreboard Game="@game" MyPlayer="@MyPlayer" />

        <GameBoard Game="@game" MyPlayer="@MyPlayer" OnCellClick="MakeMove" />

        <RematchBar Finished="@(game.Winner != Player.None || game.IsDraw)" Kind="@RematchKindFor(game)"
                    Consent="@(!IsSoloGame && RematchKindFor(game) != RematchBar.RematchKind.NextRound)"
                    State="@game.RematchState" RequestedByMe="@(game.RematchRequestedBy == MyPlayer)"
                    RequesterName="@(game.RematchRequestedBy is { } requester ? game.GetPlayerName(requester) : null)"
                    OpponentLeft="@game.HasLeft(MyPlayer == Player.X ? Player.O : Player.X)"
                    OnRematch="RestartGame" OnRequest="RequestRematch" OnAccept="AcceptRematch" OnDecline="DeclineRematch" OnBackToLobby="BackToLobby" />

        @if (game.Winner == Player.None && !game.IsDraw)
        {
            <div class="col-span-2 flex justify-center lg:col-span-1 lg:col-start-2 lg:row-start-3">
                <ArenaActions InProgress="true" OnLeave="LeaveGame" />
            </div>
        }
    </div>
}
