@page "/leaderboard"
@using TicTacToe.Modules.Gameplay
@rendermode InteractiveServer
@inject GameResultService GameResultService

<PageTitle>Classificação Geral - Ranking</PageTitle>

<div class="leaderboard-container">
    <div class="header">
        <a href="/" class="back-link">← Jogar</a>
        <h1>Classificação Geral 🏆</h1>
    </div>

    @if (_loading)
    {
        <div class="loading">Carregando ranking... ⏳</div>
    }
    else if (_ranks.Count == 0)
    {
        <div class="empty">
            <p>🏆 Nenhum jogador pontuou ainda.</p>
            <p><a href="/">Vença uma partida</a> para inaugurar o placar!</p>
        </div>
    }
    else
    {
        <table class="leaderboard-table">
            <thead>
                <tr>
                    <th scope="col" style="width: 70px;">Posição</th>
                    <th scope="col">Jogador</th>
                    <th scope="col" style="width: 110px;">Vitórias</th>
                    <th scope="col">Último Triunfo</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _ranks.Count; i++)
                {
                    var rank = _ranks[i];
                    var pos = i + 1;
                    string medal = pos switch
                    {
                        1 => "🥇",
                        2 => "🥈",
                        3 => "🥉",
                        _ => $"#{pos}"
                    };

                    <tr class="@(pos <= 3 ? "top-rank" : "")">
                        <td class="pos">@medal</td>
                        <td class="player-name">@rank.PlayerName</td>
                        <td class="wins"><strong>@rank.Wins</strong></td>
                        <td class="last-win">@rank.LastWinAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    :root { --x-color: #e74c3c; --o-color: #3498db; --bg: #1a1a2e; --surface: #16213e; --surface2: #0f3460; --text: #e0e0e0; }
    body { background: var(--bg); color: var(--text); margin: 0; }
    .leaderboard-container { font-family: 'Segoe UI', sans-serif; max-width: 700px; margin: 0 auto; padding: 40px 20px; }
    .header { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
    .back-link { color: #888; text-decoration: none; font-size: 1rem; }
    .back-link:hover { color: var(--text); }
    h1 { font-size: 1.6rem; margin: 0; }
    .loading, .empty { text-align: center; padding: 60px; color: #888; font-size: 1.1rem; }
    .empty a { color: #f1c40f; text-decoration: none; font-weight: bold; }
    .leaderboard-table { width: 100%; border-collapse: collapse; }
    .leaderboard-table th { background: var(--surface); padding: 12px 16px; text-align: left; font-size: .85rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .leaderboard-table td { padding: 14px 16px; border-bottom: 1px solid #1f2a45; font-size: 1rem; }
    .leaderboard-table tr:last-child td { border-bottom: none; }
    .leaderboard-table tr:hover td { background: rgba(255,255,255,0.03); }
    .pos { font-size: 1.2rem; }
    .top-rank td { background: rgba(241, 196, 15, 0.04); }
    .player-name { font-weight: 600; color: #fff; }
    .wins strong { color: #2ecc71; font-size: 1.2rem; }
    .last-win { color: #777; font-size: .85rem; }
</style>

@code {
    private List<PlayerRank> _ranks = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _ranks = await GameResultService.GetLeaderboardAsync(10);
        _loading = false;
    }
}
