@page "/leaderboard"
@using System.Globalization
@using TicTacToe.Modules.Gameplay
@using TicTacToe.Web.Components.Ui
@rendermode InteractiveServer
@inject GameResultService GameResultService

<PageTitle>Ranking · XO Arena</PageTitle>

<div class="mx-auto flex w-full max-w-[var(--size-frame)] flex-col gap-6 py-4">
    <PageHeader Eyebrow="Classificação" Title="Classificação Global" Subtitle="Os melhores por vitórias">
        <PillButton Href="/" Icon="play">Jogar agora</PillButton>
    </PageHeader>

    @if (_loading)
    {
        <NeonCard Class="flex items-center justify-center gap-3 p-8">
            <span class="size-6 animate-spin motion-reduce:animate-none rounded-full border-2 border-secondary border-t-transparent" aria-hidden="true"></span>
            <p role="status" class="text-body-lg text-ink-muted">Carregando ranking…</p>
        </NeonCard>
    }
    else if (_ranks.Count == 0)
    {
        <NeonCard Class="flex flex-col items-center gap-3 p-8 text-center">
            <Icon Name="trophy" Size="24" />
            <p class="text-title-sm">Nenhum jogador pontuou ainda.</p>
            <p class="text-body-md text-ink-muted">Vença uma partida para inaugurar o placar!</p>
        </NeonCard>
    }
    else
    {
        <ol aria-label="Pódio" class="grid grid-cols-3 items-end gap-3">
            @foreach (var i in PodiumOrder)
            {
                var rank = _ranks[i];
                var first = i == 0;
                <li data-podium="@(i + 1)" class="@PodiumCss(first)">
                    <Icon Name="@(first ? "trophy" : "medal")" Size="24" />
                    <span class="font-numeric text-label-badge uppercase text-gold">@(i + 1)º</span>
                    <span class="w-full min-w-0 break-words text-title-sm">@rank.PlayerName</span>
                    <span class="font-numeric text-label-numeric text-ink-muted">@rank.Wins @(rank.Wins == 1 ? "vitória" : "vitórias")</span>
                </li>
            }
        </ol>

        <NeonCard Class="overflow-hidden">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr class="border-b border-stroke font-numeric text-label-badge uppercase text-ink-muted">
                        <th scope="col" class="w-20 px-4 py-3">Posição</th>
                        <th scope="col" class="px-4 py-3">Jogador</th>
                        <th scope="col" class="px-4 py-3">Vitórias</th>
                        <th scope="col" class="hidden px-4 py-3 md:table-cell">Último triunfo</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _ranks.Count; i++)
                    {
                        var rank = _ranks[i];
                        <tr class="@(i < 3 ? "bg-gold/10 " : "")border-b border-stroke last:border-b-0">
                            <td class="px-4 py-3 font-numeric text-label-numeric">@(i + 1)º</td>
                            <td class="break-words px-4 py-3 text-body-lg">@rank.PlayerName</td>
                            <td class="px-4 py-3 font-numeric text-label-numeric text-success">@rank.Wins</td>
                            <td class="hidden px-4 py-3 font-numeric text-label-numeric text-ink-muted md:table-cell">@FormatDate(rank.LastWinAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </NeonCard>
    }
</div>

@code {
    private List<PlayerRank> _ranks = [];
    private bool _loading = true;

    // Ordem visual do pódio: 2º à esquerda, 1º ao centro, 3º à direita (só os que existem).
    private IEnumerable<int> PodiumOrder => new[] { 1, 0, 2 }.Where(i => i < _ranks.Count);

    private static string PodiumCss(bool first) =>
        "flex min-w-0 flex-col items-center gap-1 rounded-card border bg-surface/80 p-4 text-center backdrop-blur-md " +
        (first ? "min-h-56 border-gold shadow-[0_0_24px_rgb(243_156_18/0.35)]" : "min-h-44 border-stroke");

    private static string FormatDate(DateTime lastWinUtc) =>
        DateTime.SpecifyKind(lastWinUtc, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM HH:mm", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _ranks = await GameResultService.GetLeaderboardAsync(10);
        _loading = false;
    }
}
