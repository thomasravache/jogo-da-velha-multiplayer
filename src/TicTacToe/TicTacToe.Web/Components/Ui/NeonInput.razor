<div class="flex w-full flex-col gap-1">
    <label for="@InputId" class="font-numeric text-label-badge uppercase text-ink-muted">@Label</label>
    <input id="@InputId" type="text" maxlength="@MaxLength" placeholder="@Placeholder" value="@(Value ?? "")" @oninput="HandleInput"
           class="w-full rounded-pill border border-stroke bg-surface-high/60 px-5 py-3 text-body-lg text-ink placeholder:text-ink-muted/60 focus-visible:border-stroke-active focus-visible:outline-2 focus-visible:outline-secondary" />
    @if (ShowCounter)
    {
        <span class="self-end font-numeric text-label-badge text-ink-muted">@(Value?.Length ?? 0)/@MaxLength</span>
    }
</div>

@code {
    private readonly string _generatedId = $"ni-{Guid.NewGuid():N}";

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int MaxLength { get; set; } = 20;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool ShowCounter { get; set; }

    private string InputId => Id ?? _generatedId;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }
}
