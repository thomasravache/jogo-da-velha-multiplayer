<div class="flex w-full flex-col gap-1 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-1">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <p class="font-numeric text-label-badge uppercase text-secondary">@Eyebrow</p>
        }
        <h1 class="text-headline-lg-mobile font-display text-ink md:text-headline-lg">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="text-body-md text-ink-muted">@Subtitle</p>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="flex items-center gap-2">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
