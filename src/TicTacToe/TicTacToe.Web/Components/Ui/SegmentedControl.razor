@typeparam TValue

<div role="radiogroup" aria-label="@AriaLabel" class="inline-flex w-full gap-1 rounded-pill border border-stroke bg-surface-high/40 p-1">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var item = Items[i];
        var selected = IsSelected(item.Value);
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                class="@ItemCss(selected)"
                @onclick="() => Select(item.Value)"
                @onkeydown="e => HandleKey(e, index)">@item.Label</button>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<(TValue Value, string Label)> Items { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "";

    private bool IsSelected(TValue candidate) => EqualityComparer<TValue>.Default.Equals(candidate, Value!);

    private static string ItemCss(bool selected) =>
        "min-h-11 flex-1 rounded-pill px-4 font-numeric text-label-numeric uppercase transition focus-visible:outline-2 focus-visible:outline-secondary " +
        (selected ? "bg-surface-high text-ink shadow-[0_0_12px_rgb(0_210_211/0.25)]" : "text-ink-muted hover:text-ink");

    private Task Select(TValue value) => ValueChanged.InvokeAsync(value);

    private Task HandleKey(KeyboardEventArgs e, int index)
    {
        var count = Items.Count;
        if (count == 0) return Task.CompletedTask;
        var target = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => (index + 1) % count,
            "ArrowLeft" or "ArrowUp" => (index - 1 + count) % count,
            _ => -1,
        };
        return target < 0 ? Task.CompletedTask : Select(Items[target].Value);
    }
}
